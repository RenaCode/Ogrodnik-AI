# Skopiuj do .env (`cp .env.example .env`) i uzupełnij.
# Copy to .env and fill in.

# --- WYMAGANE / REQUIRED -----------------------------------------------------
# Bez tych dwóch zmiennych aplikacja NIE wystartuje - to celowe. Repo jest
# publiczne, więc jakakolwiek wartość domyślna byłaby znana wszystkim, a login
# chroni zakładkę "Ustawienia" z tokenem Home Assistanta i kluczami API.
# Without these two the app refuses to start - this is deliberate.

# Hasło do panelu. / Admin panel password.
ADMIN_PASSWORD=

# Klucz podpisu sesji - osobny sekret, NIE to samo co hasło.
# Session signing key - a separate secret, NOT the password.
# Wygeneruj / generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- OPCJONALNE / OPTIONAL ---------------------------------------------------
# Wszystkie klucze poniżej można też wpisać w aplikacji (zakładka "Ustawienia").
# All keys below can also be entered in the app under "Settings".

ADMIN_USERNAME=admin

GARDEN_NAME=Mój ogród
GARDEN_LAT=52.2297
GARDEN_LON=21.0122

HYDRAWISE_API_KEY=

HA_BASE_URL=
HA_LONG_LIVED_TOKEN=
HA_MOWER_ENTITY_ID=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

POLL_INTERVAL_MINUTES=5

# Sieci (CIDR, po przecinku), z ktorych wolno wierzyc naglowkowi
# X-Forwarded-For przy ustalaniu adresu klienta - patrz app/main.py:_client_ip.
# Trusted proxy networks for X-Forwarded-For.
#
# DOPOKI TO JEST PUSTE, limit prob logowania dziala GLOBALNIE, nie per adres:
# za odwrotnym proxy kazde polaczenie przychodzi z tego samego adresu, wiec
# wszyscy klienci - razem z wlascicielem - dziela jeden licznik, a ktokolwiek
# moze trzymac panel zamkniety przed wlascicielem samymi bledny mi haslami.
# Na k3s siec podow to domyslnie 10.42.0.0/16.
# Puste = nie ufamy naglowkowi wcale (bezpieczny domysl: ufanie mu bez
# wskazania sieci proxy pozwala kazdemu dopisac losowy adres i miec czysty
# licznik do kazdej proby hasla).
TRUSTED_PROXY_CIDRS=
